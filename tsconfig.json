{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2023", "WebWorker"],
    "types": ["@cloudflare/workers-types", "node"], "strict": true, "noEmit": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "allowJs": true, "checkJs": false, "isolatedModules": true, "resolveJsonModule": true
  },
  "include": ["src", "pipeline"]
}
